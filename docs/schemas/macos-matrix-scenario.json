{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basefoundry.github.io/base/schemas/macos-matrix-scenario.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "preconditions", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "preconditions": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "expected_exit"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expected_exit": {"type": "integer", "minimum": 0, "maximum": 255},
        "stdout_contains": {"type": "array", "items": {"type": "string"}},
        "stderr_contains": {"type": "array", "items": {"type": "string"}},
        "stdout_not_contains": {"type": "array", "items": {"type": "string"}},
        "stderr_not_contains": {"type": "array", "items": {"type": "string"}},
        "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "cwd": {"type": "string", "minLength": 1}
      }
    }
  }
}
