{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basefoundry.github.io/base/schemas/macos-matrix-result.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "scenario", "base", "platform", "cell", "account", "route", "shell", "started_at", "completed_at", "status", "preconditions", "steps", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "scenario": {"$ref": "#/$defs/scenario"},
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "architecture"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}
      }
    },
    "cell": {"enum": ["source-bash", "source-zsh", "brew-bash", "brew-zsh"]},
    "account": {"enum": ["base-source-bash", "base-source-zsh", "base-brew-bash", "base-brew-zsh"]},
    "route": {"enum": ["source", "homebrew"]},
    "shell": {"enum": ["bash", "zsh"]},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed", "blocked"]},
    "preconditions": {"type": "array", "items": {"$ref": "#/$defs/step_result"}},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step_result"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_steps", "message"],
      "properties": {
        "status": {"enum": ["passed", "failed", "blocked"]},
        "failed_steps": {"type": "array", "items": {"type": "string"}},
        "message": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "step_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "expected_exit", "actual_exit", "status", "duration_ms", "finding_ids", "log_path"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expected_exit": {"type": "integer", "minimum": 0, "maximum": 255},
        "actual_exit": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
        "status": {"enum": ["passed", "failed", "blocked"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "log_path": {"type": "string", "minLength": 1},
        "error": {"type": "string", "minLength": 1}
      }
    }
  }
}
