#!/usr/bin/env bash
# shellcheck shell=bash

base_release_inputs_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)" || exit 1
base_release_inputs_pythonpath="$base_release_inputs_root/cli/python"
if [[ -n "${PYTHONPATH:-}" ]]; then
    base_release_inputs_pythonpath="$base_release_inputs_pythonpath:$PYTHONPATH"
fi
PYTHONPATH="$base_release_inputs_pythonpath" exec python3 -m base_release.release_input_verifier "$@"
